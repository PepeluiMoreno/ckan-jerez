# Producción ckan-jerez. Copia fuera del repo como .env.production y rellena.
# ckan-jerez es una app INDEPENDIENTE suscrita a ODM por su API pública.
# NUNCA usa la BD ni la red interna de ODM.

APP_PREFIX=ckanjerez

# ODM como PROVEEDOR, solo vía su API pública.
ODM_API_URL=https://odmgr.pepelui.es

# Autenticación (opción A): cuenta de servicio con rol de MÍNIMO PRIVILEGIO en ODM
# (permisos recursos.crear, recursos.editar y lectura). El cliente hace login en
# /api/auth/login y reutiliza la cookie de sesión.
ODM_USER=svc-ckan-jerez
ODM_PASSWORD=CHANGE_ME

# (opción B, pendiente en ODM) token de servicio revocable por cabecera Bearer:
# ODM_API_TOKEN=

# Secreto compartido del webhook (HMAC-SHA256) que firma ODM al notificar cargas.
ODM_WEBHOOK_SECRET=CHANGE_ME

# (futuro) CKAN propio de Jerez.
CKAN_URL=
CKAN_API_TOKEN=

# URL pública del suscriptor (de aquí sale el webhook_url que se registra en ODM)
PUBLIC_BASE_URL=https://ckan-mgr.pepelui.es
