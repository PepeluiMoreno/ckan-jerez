# Variables del stack CKAN de ckan-jerez (ckan.pepelui.es).
# Copia a .env.production (junto a las de la app) y rellena los secretos.
# Genera los secretos con, p.ej.:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# Prefijo de nombres de contenedor/red (compartido con la app)
APP_PREFIX=ckanjerez

# Base de datos CKAN + DataStore
CKAN_DB_PASSWORD=cambia-esto
DATASTORE_RO_PASSWORD=cambia-esto

# Secretos de CKAN
CKAN_SESSION_SECRET=cambia-esto
CKAN_JWT_SECRET=cambia-esto
CKAN_DATAPUSHER_TOKEN=

# Cuenta sysadmin inicial (se crea en el primer arranque, ver puesta en marcha)
CKAN_SYSADMIN_NAME=admin
CKAN_SYSADMIN_PASSWORD=cambia-esto
CKAN_SYSADMIN_EMAIL=admin@pepelui.es

# El exportador (services/ckan_publisher.py) publica contra esta instancia:
#   CKAN_URL=https://ckan.pepelui.es
#   CKAN_API_TOKEN=<token de la cuenta de servicio, se crea desde el panel de CKAN>
